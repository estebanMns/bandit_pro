# Un solo origen para el frontend, la API y los WebSocket.
:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /ws/* {
		reverse_proxy backend:8000
	}

	# WHIP/WHEP de MediaMTX (Bandit Mobile Camera). La autorización la decide el backend.
	handle_path /media/* {
		reverse_proxy mediamtx:8889
	}

	handle {
		reverse_proxy frontend:3000
	}
}
