# coturn para Bandit Mobile Camera (TURN con credenciales temporales).
# Copia este archivo a turnserver.conf y reemplaza los valores <...>. No subas turnserver.conf.
listening-port=3478
tls-listening-port=5349
fingerprint
# Credenciales temporales (API REST de TURN): el backend las firma con este mismo secreto
# (WEBRTC_TURN_SHARED_SECRET). Nunca se usan usuarios fijos.
use-auth-secret
static-auth-secret=<MISMO_VALOR_QUE_WEBRTC_TURN_SHARED_SECRET>
realm=<tu-dominio>
external-ip=<IP_PUBLICA>
min-port=49160
max-port=49200
no-cli
no-multicast-peers
# No relevar hacia redes privadas: evita que TURN sirva para entrar a la red interna.
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
# Certificados para TURN sobre TLS (redes que solo dejan salir 443/5349):
# cert=/etc/coturn/fullchain.pem
# pkey=/etc/coturn/privkey.pem
